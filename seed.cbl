IDENTIFICATION DIVISION.
PROGRAM-ID. SEED-LEDGER.

ENVIRONMENT DIVISION.
INPUT-OUTPUT SECTION.
FILE-CONTROL.
    SELECT TRANSACTIONS-FILE ASSIGN TO "data/ledger.dat"
        ORGANIZATION IS INDEXED
        ACCESS MODE IS DYNAMIC
        RECORD KEY IS TRANS-ID
        ALTERNATE RECORD KEY IS TRANS-DATE WITH DUPLICATES
        FILE STATUS IS FS-LEDGER.

DATA DIVISION.
FILE SECTION.
FD  TRANSACTIONS-FILE.
01  TRANS-RECORD.
    05  TRANS-ID            PIC 9(6).
    05  TRANS-DATE          PIC X(10).
    05  TRANS-CAT           PIC X(15).
    05  TRANS-DESC          PIC X(30).
    05  TRANS-AMOUNT        PIC S9(7)V99.

WORKING-STORAGE SECTION.
01  FS-LEDGER               PIC XX.
01  W-FORCE                 PIC X(10).
01  W-EXISTS                BINARY-LONG.

PROCEDURE DIVISION.
    CALL STATIC "access" USING BY REFERENCE Z"data/ledger.sqlite3"
        BY VALUE 0 RETURNING W-EXISTS END-CALL.
    IF W-EXISTS = 0
        DISPLAY "Seed este numai pentru demo. Exista deja un registru SQLite."
        MOVE 1 TO RETURN-CODE STOP RUN
    END-IF.
*>  Guard: nu suprascrie o baza de date existenta decat cu SEED_FORCE=1.
    DISPLAY "SEED_FORCE" UPON ENVIRONMENT-NAME.
    ACCEPT W-FORCE FROM ENVIRONMENT-VALUE.
    IF W-FORCE(1:1) NOT = "1"
        CALL STATIC "access" USING BY REFERENCE Z"data/ledger.dat"
            BY VALUE 0 RETURNING W-EXISTS END-CALL
        IF W-EXISTS = 0
            DISPLAY "data/ledger.dat exista deja. "
                    "Ruleaza cu SEED_FORCE=1 pentru a suprascrie."
            MOVE 1 TO RETURN-CODE STOP RUN
        END-IF
    END-IF.
    DISPLAY "Re-seeding with alternate keys...".
    OPEN OUTPUT TRANSACTIONS-FILE.
    IF FS-LEDGER NOT = "00" MOVE 1 TO RETURN-CODE STOP RUN END-IF.
    
    MOVE 1 TO TRANS-ID.
    MOVE "2026-04-10" TO TRANS-DATE.
    MOVE "Venituri"   TO TRANS-CAT.
    MOVE "Salariu Martie" TO TRANS-DESC.
    MOVE 5500.00 TO TRANS-AMOUNT.
    WRITE TRANS-RECORD.

    MOVE 2 TO TRANS-ID.
    MOVE "2026-04-15" TO TRANS-DATE.
    MOVE "Locuinta"   TO TRANS-CAT.
    MOVE "Chirie" TO TRANS-DESC.
    MOVE -1200.00 TO TRANS-AMOUNT.
    WRITE TRANS-RECORD.

    MOVE 3 TO TRANS-ID.
    MOVE "2026-04-12" TO TRANS-DATE.
    MOVE "Utilitati"  TO TRANS-CAT.
    MOVE "Internet" TO TRANS-DESC.
    MOVE -55.00 TO TRANS-AMOUNT.
    WRITE TRANS-RECORD.

    CLOSE TRANSACTIONS-FILE.
    STOP RUN.
