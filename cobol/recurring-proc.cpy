*> All entry points run under the bridge flock. P records are durable redo
*> intents; D records are retained as occurrence tombstones after a deletion.
OPEN-RULES.
    OPEN I-O RULES-FILE.
    IF FS-RULES = "35"
        CALL STATIC "access" USING BY REFERENCE Z"data/recurring.dat"
            BY VALUE 0 RETURNING W-FILE-EXISTS END-CALL
        IF W-FILE-EXISTS = 0
            PERFORM NATIVE-STORAGE-ERROR
            EXIT PARAGRAPH
        END-IF
        OPEN OUTPUT RULES-FILE
        CLOSE RULES-FILE
        OPEN I-O RULES-FILE
    END-IF.
    IF FS-RULES NOT = "00" PERFORM NATIVE-STORAGE-ERROR END-IF.

OPEN-OCCURRENCES.
    OPEN I-O OCCURRENCES-FILE.
    IF FS-OCC = "35"
        CALL STATIC "access" USING BY REFERENCE Z"data/occurrences.dat"
            BY VALUE 0 RETURNING W-FILE-EXISTS END-CALL
        IF W-FILE-EXISTS = 0
            PERFORM NATIVE-STORAGE-ERROR
            EXIT PARAGRAPH
        END-IF
        OPEN OUTPUT OCCURRENCES-FILE
        CLOSE OCCURRENCES-FILE
        OPEN I-O OCCURRENCES-FILE
    END-IF.
    IF FS-OCC NOT = "00" PERFORM NATIVE-STORAGE-ERROR END-IF.

READ-RULE-ID.
    MOVE "id" TO W-KEY-LOOKUP.
    PERFORM GET-FORM-VALUE.
    MOVE W-VALUE-OUT TO W-EDIT-ID-RAW.
    PERFORM PARSE-EDIT-ID.
    MOVE W-EDIT-ID TO R-ID.
    IF R-ID = 0
        MOVE "Regula invalida." TO W-ERROR-MSG
        MOVE "Y" TO W-HAS-ERROR
    END-IF.

SAVE-RULE.
    MOVE "RECURRING" TO W-VIEW.
    MOVE "date" TO W-KEY-LOOKUP.
    PERFORM GET-FORM-VALUE.
    MOVE W-VALUE-OUT TO W-DATE-RAW.
    PERFORM VALIDATE-DATE.
    IF W-VALID NOT = "Y" OR W-DATE-RAW < "1601-01-01"
        MOVE "Alege o data valida, incepand cu anul 1601." TO W-ERROR-MSG
        MOVE "Y" TO W-HAS-ERROR
        EXIT PARAGRAPH
    END-IF.
    MOVE "cat" TO W-KEY-LOOKUP.
    PERFORM GET-FORM-VALUE.
    MOVE W-VALUE-OUT TO W-CAT-RAW.
    PERFORM VALIDATE-CATEGORY.
    IF W-VALID NOT = "Y"
        MOVE "Categorie invalida." TO W-ERROR-MSG
        MOVE "Y" TO W-HAS-ERROR
        EXIT PARAGRAPH
    END-IF.
    MOVE "desc" TO W-KEY-LOOKUP.
    PERFORM GET-FORM-VALUE.
    MOVE W-VALUE-OUT TO W-DESC-RAW.
    MOVE "amount" TO W-KEY-LOOKUP.
    PERFORM GET-FORM-VALUE.
    MOVE W-VALUE-OUT TO W-AMOUNT-RAW.
    PERFORM VALIDATE-AMOUNT.
    IF W-VALID NOT = "Y" OR W-AMOUNT-NUM = 0 OR W-DESC-RAW = SPACES
        MOVE "Completeaza descrierea si o suma diferita de zero." TO W-ERROR-MSG
        MOVE "Y" TO W-HAS-ERROR
        EXIT PARAGRAPH
    END-IF.
    MOVE "cycle" TO W-KEY-LOOKUP.
    PERFORM GET-FORM-VALUE.
    MOVE W-VALUE-OUT TO R-CYCLE.
    IF R-CYCLE NOT = "MONTHLY" AND "WEEKLY" AND "YEARLY"
        MOVE "Frecventa invalida." TO W-ERROR-MSG
        MOVE "Y" TO W-HAS-ERROR
        EXIT PARAGRAPH
    END-IF.
    MOVE "id" TO W-KEY-LOOKUP.
    PERFORM GET-FORM-VALUE.
    MOVE 0 TO R-ID.
    IF W-VALUE-OUT NOT = SPACES PERFORM READ-RULE-ID END-IF.
    IF W-HAS-ERROR = "Y" EXIT PARAGRAPH END-IF.
    PERFORM OPEN-RULES.
    IF W-STORAGE-ERROR = "Y" EXIT PARAGRAPH END-IF.
    IF R-ID = 0
        MOVE "create_key" TO W-KEY-LOOKUP
        PERFORM GET-FORM-VALUE
        IF FUNCTION LENGTH(FUNCTION TRIM(W-VALUE-OUT)) NOT = 32
            CLOSE RULES-FILE
            MOVE "Cerere incompleta. Reincarca formularul." TO W-ERROR-MSG
            MOVE "Y" TO W-HAS-ERROR
            EXIT PARAGRAPH
        END-IF
        MOVE W-VALUE-OUT TO R-CREATE-KEY RULE-CREATE-KEY
        READ RULES-FILE KEY IS RULE-CREATE-KEY
            INVALID KEY CONTINUE
            NOT INVALID KEY
                CLOSE RULES-FILE
                MOVE "ruledupe" TO W-RESULT
                EXIT PARAGRAPH
        END-READ
        MOVE HIGH-VALUES TO RULE-ID
        MOVE 0 TO R-LAST
        START RULES-FILE KEY IS LESS THAN RULE-ID
            INVALID KEY CONTINUE
            NOT INVALID KEY
                READ RULES-FILE PREVIOUS
                    AT END CONTINUE
                    NOT AT END MOVE RULE-ID TO R-LAST
                END-READ
        END-START
        IF R-LAST = 999999
            CLOSE RULES-FILE
            MOVE "Limita de reguli a fost atinsa." TO W-ERROR-MSG
            MOVE "Y" TO W-HAS-ERROR
            EXIT PARAGRAPH
        END-IF
        COMPUTE R-ID = R-LAST + 1
        MOVE R-ID TO RULE-ID
        MOVE R-CREATE-KEY TO RULE-CREATE-KEY
        MOVE "Y" TO RULE-ACTIVE
        MOVE "N" TO RULE-ARCHIVED
        PERFORM FILL-RULE
        WRITE RULE-RECORD END-WRITE
    ELSE
        MOVE R-ID TO RULE-ID
        READ RULES-FILE
            INVALID KEY MOVE "Y" TO W-HAS-ERROR
            NOT INVALID KEY
                IF RULE-ARCHIVED = "Y"
                    MOVE "Y" TO W-HAS-ERROR
                ELSE
                    PERFORM FILL-RULE
                    REWRITE RULE-RECORD END-REWRITE
                END-IF
        END-READ
    END-IF.
    IF FS-RULES NOT = "00" OR W-HAS-ERROR = "Y"
        MOVE "Regula nu a putut fi salvata." TO W-ERROR-MSG
        MOVE "Y" TO W-HAS-ERROR
    ELSE
        MOVE "rulesave" TO W-RESULT
        MOVE "RULE-SAVE" TO W-AUDIT-ACTION
        PERFORM AUDIT-RULE
    END-IF.
    CLOSE RULES-FILE.

FILL-RULE.
    MOVE W-DATE-RAW TO RULE-DATE.
    MOVE W-CAT-RAW TO RULE-CAT.
    MOVE W-DESC-RAW TO RULE-DESC.
    MOVE W-AMOUNT-NUM TO RULE-AMOUNT.
    MOVE R-CYCLE TO RULE-CYCLE.
    MOVE W-DATE-RAW(9:2) TO RULE-ANCHOR.

TOGGLE-RULE.
    MOVE "RECURRING" TO W-VIEW.
    PERFORM READ-RULE-ID.
    IF W-HAS-ERROR = "Y" EXIT PARAGRAPH END-IF.
    PERFORM OPEN-RULES.
    IF W-STORAGE-ERROR = "Y" EXIT PARAGRAPH END-IF.
    MOVE R-ID TO RULE-ID.
    READ RULES-FILE
        INVALID KEY MOVE "Y" TO W-HAS-ERROR
        NOT INVALID KEY
            IF W-CMD = "rule-archive"
                MOVE "Y" TO RULE-ARCHIVED
                MOVE "N" TO RULE-ACTIVE
            ELSE
                IF RULE-ARCHIVED = "Y"
                    MOVE "Y" TO W-HAS-ERROR
                ELSE
                    IF RULE-ACTIVE = "Y" MOVE "N" TO RULE-ACTIVE
                    ELSE MOVE "Y" TO RULE-ACTIVE END-IF
                END-IF
            END-IF
            IF W-HAS-ERROR NOT = "Y" REWRITE RULE-RECORD END-REWRITE END-IF
    END-READ.
    IF FS-RULES = "00" AND W-HAS-ERROR NOT = "Y"
        MOVE "rulemode" TO W-RESULT
        MOVE "RULE-MODE" TO W-AUDIT-ACTION
        PERFORM AUDIT-RULE
    ELSE
        MOVE "Regula nu poate fi modificata." TO W-ERROR-MSG
        MOVE "Y" TO W-HAS-ERROR
    END-IF.
    CLOSE RULES-FILE.

AUDIT-RULE.
    MOVE SPACES TO W-AUDIT-DETAIL.
    STRING "rule=" R-ID INTO W-AUDIT-DETAIL END-STRING.
    PERFORM WRITE-AUDIT.

RAISE-RESERVED-ID.
    OPEN INPUT OCCURRENCES-FILE.
    IF FS-OCC = "35"
        CALL STATIC "access" USING BY REFERENCE Z"data/occurrences.dat"
            BY VALUE 0 RETURNING W-FILE-EXISTS END-CALL
        IF W-FILE-EXISTS = 0 PERFORM NATIVE-STORAGE-ERROR END-IF
        EXIT PARAGRAPH
    END-IF.
    IF FS-OCC NOT = "00" PERFORM NATIVE-STORAGE-ERROR EXIT PARAGRAPH END-IF.
    MOVE HIGH-VALUES TO OCC-TX-ID.
    START OCCURRENCES-FILE KEY IS LESS THAN OCC-TX-ID
        INVALID KEY CONTINUE
        NOT INVALID KEY
            READ OCCURRENCES-FILE PREVIOUS
                AT END CONTINUE
                NOT AT END
                    IF OCC-TX-ID IS NUMERIC
                        COMPUTE W-LAST-ID = FUNCTION MAX(W-LAST-ID, OCC-TX-ID)
                    ELSE PERFORM NATIVE-STORAGE-ERROR END-IF
            END-READ
    END-START.
    CLOSE OCCURRENCES-FILE.

BOOK-RULE.
    MOVE "RECURRING" TO W-VIEW.
    PERFORM READ-RULE-ID.
    MOVE "due" TO W-KEY-LOOKUP.
    PERFORM GET-FORM-VALUE.
    MOVE W-VALUE-OUT TO R-DUE W-DATE-RAW.
    PERFORM VALIDATE-DATE.
    IF W-HAS-ERROR = "Y" OR W-VALID NOT = "Y"
        MOVE "Scadenta invalida." TO W-ERROR-MSG
        MOVE "Y" TO W-HAS-ERROR
        EXIT PARAGRAPH
    END-IF.
    PERFORM OPEN-OCCURRENCES.
    IF W-STORAGE-ERROR = "Y" EXIT PARAGRAPH END-IF.
    MOVE R-ID TO OCC-RULE.
    MOVE R-DUE TO OCC-DATE.
    READ OCCURRENCES-FILE
        INVALID KEY CONTINUE
        NOT INVALID KEY
            MOVE OCC-RECORD TO R-SAVED-INTENT
            CLOSE OCCURRENCES-FILE
            IF R-OCC-STATE NOT = "P" AND "D"
                PERFORM NATIVE-STORAGE-ERROR EXIT PARAGRAPH
            END-IF
            IF R-OCC-STATE = "P" PERFORM APPLY-INTENT END-IF
            IF W-STORAGE-ERROR NOT = "Y"
                PERFORM ADVANCE-INTENT-RULE
                MOVE "already" TO W-RESULT
            END-IF
            EXIT PARAGRAPH
    END-READ.
    CLOSE OCCURRENCES-FILE.
    PERFORM OPEN-RULES.
    IF W-STORAGE-ERROR = "Y" EXIT PARAGRAPH END-IF.
    MOVE R-ID TO RULE-ID.
    READ RULES-FILE
        INVALID KEY MOVE "Y" TO W-HAS-ERROR
        NOT INVALID KEY
            IF RULE-DATE NOT = R-DUE OR RULE-ACTIVE NOT = "Y"
               OR RULE-ARCHIVED = "Y" OR R-DUE > W-TODAY-STR
                MOVE "Y" TO W-HAS-ERROR
            END-IF
    END-READ.
    IF W-HAS-ERROR = "Y"
        CLOSE RULES-FILE
        MOVE "Scadenta nu mai este disponibila. Reincarca lista." TO W-ERROR-MSG
        EXIT PARAGRAPH
    END-IF.
    PERFORM VALIDATE-STORED-RULE.
    MOVE RULE-RECORD TO R-SAVED-RULE.
    CLOSE RULES-FILE.
    IF W-STORAGE-ERROR = "Y" EXIT PARAGRAPH END-IF.
    PERFORM OPEN-LEDGER-FILE.
    IF FS-LEDGER NOT = "00" PERFORM NATIVE-STORAGE-ERROR EXIT PARAGRAPH END-IF.
    PERFORM SQL-HIGHWATER.
    PERFORM SQL-CLOSE.
    PERFORM RAISE-RESERVED-ID.
    IF W-STORAGE-ERROR = "Y" EXIT PARAGRAPH END-IF.
    IF W-LAST-ID = 999999
        MOVE "Limita de tranzactii a fost atinsa." TO W-ERROR-MSG
        MOVE "Y" TO W-HAS-ERROR
        EXIT PARAGRAPH
    END-IF.
    MOVE R-SAVED-RULE TO RULE-RECORD.
    MOVE R-ID TO R-OCC-RULE.
    MOVE R-DUE TO R-OCC-DATE R-OCC-DATE-TX.
    MOVE "P" TO R-OCC-STATE.
    COMPUTE R-OCC-ID = W-LAST-ID + 1.
    MOVE RULE-CAT TO R-OCC-CAT.
    MOVE RULE-DESC TO R-OCC-DESC.
    MOVE RULE-AMOUNT TO R-OCC-AMOUNT.
    PERFORM OPEN-OCCURRENCES.
    IF W-STORAGE-ERROR = "Y" EXIT PARAGRAPH END-IF.
    MOVE R-SAVED-INTENT TO OCC-RECORD.
    WRITE OCC-RECORD END-WRITE.
    IF FS-OCC NOT = "00" PERFORM NATIVE-STORAGE-ERROR END-IF.
    CLOSE OCCURRENCES-FILE.
    IF W-STORAGE-ERROR = "Y" EXIT PARAGRAPH END-IF.
    IF R-FAULT = "after-intent" MOVE 97 TO RETURN-CODE STOP RUN END-IF.
    PERFORM APPLY-INTENT.
    IF W-STORAGE-ERROR NOT = "Y"
        PERFORM ADVANCE-INTENT-RULE
        MOVE "booked" TO W-RESULT
    END-IF.

APPLY-INTENT.
    IF R-OCC-ID IS NOT NUMERIC OR R-OCC-ID = 0
       OR R-OCC-AMOUNT IS NOT NUMERIC
        PERFORM NATIVE-STORAGE-ERROR EXIT PARAGRAPH
    END-IF.
    PERFORM OPEN-LEDGER-FILE.
    IF FS-LEDGER NOT = "00" PERFORM NATIVE-STORAGE-ERROR EXIT PARAGRAPH END-IF.
    MOVE R-OCC-ID TO TRANS-ID.
    PERFORM SQL-READ
    IF FS-LEDGER NOT = "00"
            IF FS-LEDGER = "23"
                MOVE R-OCC-TX TO TRANS-RECORD
                PERFORM SQL-INSERT
                IF FS-LEDGER NOT = "00" PERFORM NATIVE-STORAGE-ERROR END-IF
            ELSE PERFORM NATIVE-STORAGE-ERROR END-IF
        ELSE
            IF TRANS-RECORD NOT = R-OCC-TX PERFORM NATIVE-STORAGE-ERROR END-IF
    END-IF.
    PERFORM SQL-CLOSE.
    IF W-STORAGE-ERROR = "Y" EXIT PARAGRAPH END-IF.
    IF R-FAULT = "after-ledger" MOVE 97 TO RETURN-CODE STOP RUN END-IF.
    PERFORM OPEN-OCCURRENCES.
    IF W-STORAGE-ERROR = "Y" EXIT PARAGRAPH END-IF.
    MOVE R-OCC-KEY TO OCC-KEY.
    READ OCCURRENCES-FILE
        INVALID KEY PERFORM NATIVE-STORAGE-ERROR
        NOT INVALID KEY
            MOVE "D" TO OCC-STATE
            REWRITE OCC-RECORD END-REWRITE
            IF FS-OCC NOT = "00" PERFORM NATIVE-STORAGE-ERROR END-IF
    END-READ.
    CLOSE OCCURRENCES-FILE.
    IF W-STORAGE-ERROR = "Y" EXIT PARAGRAPH END-IF.
    MOVE "RECURRING" TO W-AUDIT-ACTION.
    MOVE SPACES TO W-AUDIT-DETAIL.
    STRING "rule=" R-OCC-RULE " due=" R-OCC-DATE " id=" R-OCC-ID
        INTO W-AUDIT-DETAIL END-STRING.
    PERFORM WRITE-AUDIT.
    IF R-FAULT = "after-done" MOVE 97 TO RETURN-CODE STOP RUN END-IF.

ADVANCE-INTENT-RULE.
    PERFORM OPEN-RULES.
    IF W-STORAGE-ERROR = "Y" EXIT PARAGRAPH END-IF.
    MOVE R-OCC-RULE TO RULE-ID.
    READ RULES-FILE
        INVALID KEY PERFORM NATIVE-STORAGE-ERROR
        NOT INVALID KEY
            PERFORM VALIDATE-STORED-RULE
            IF W-STORAGE-ERROR NOT = "Y" AND RULE-DATE = R-OCC-DATE
                PERFORM CALCULATE-NEXT-DATE
                IF R-NEXT = SPACES
                    MOVE "N" TO RULE-ACTIVE
                ELSE MOVE R-NEXT TO RULE-DATE END-IF
                REWRITE RULE-RECORD END-REWRITE
                IF FS-RULES NOT = "00" PERFORM NATIVE-STORAGE-ERROR END-IF
            END-IF
    END-READ.
    CLOSE RULES-FILE.

CALCULATE-NEXT-DATE.
    MOVE SPACES TO R-NEXT.
    MOVE RULE-DATE(1:4) TO R-YEAR.
    MOVE RULE-DATE(6:2) TO R-MONTH.
    MOVE RULE-ANCHOR TO R-DAY.
    IF RULE-CYCLE = "WEEKLY"
        STRING RULE-DATE(1:4) RULE-DATE(6:2) RULE-DATE(9:2)
            INTO R-DATE-NUM END-STRING
        COMPUTE R-INT-DATE = FUNCTION INTEGER-OF-DATE(R-DATE-NUM) + 7
        IF R-INT-DATE > FUNCTION INTEGER-OF-DATE(99991231) EXIT PARAGRAPH END-IF
        MOVE FUNCTION DATE-OF-INTEGER(R-INT-DATE) TO R-DATE-NUM
        STRING R-DATE-NUM(1:4) "-" R-DATE-NUM(5:2) "-" R-DATE-NUM(7:2)
            INTO R-NEXT END-STRING
        EXIT PARAGRAPH
    END-IF.
    IF RULE-CYCLE = "YEARLY"
        IF R-YEAR = 9999 EXIT PARAGRAPH END-IF
        ADD 1 TO R-YEAR
    ELSE
        IF R-MONTH = 12
            IF R-YEAR = 9999 EXIT PARAGRAPH END-IF
            ADD 1 TO R-YEAR MOVE 1 TO R-MONTH
        ELSE ADD 1 TO R-MONTH END-IF
    END-IF.
    MOVE "N" TO W-VALID.
    PERFORM UNTIL W-VALID = "Y" OR R-DAY = 0
        STRING R-YEAR "-" R-MONTH "-" R-DAY INTO W-DATE-RAW END-STRING
        PERFORM VALIDATE-DATE
        IF W-VALID NOT = "Y" SUBTRACT 1 FROM R-DAY END-IF
    END-PERFORM.
    IF W-VALID = "Y" MOVE W-DATE-RAW TO R-NEXT END-IF.

RECOVER-OCCURRENCES.
    PERFORM VARYING R-LOOPS FROM 1 BY 1 UNTIL R-LOOPS > 100
        OPEN INPUT OCCURRENCES-FILE
        IF FS-OCC = "35"
            CALL STATIC "access" USING BY REFERENCE Z"data/occurrences.dat"
                BY VALUE 0 RETURNING W-FILE-EXISTS END-CALL
            IF W-FILE-EXISTS = 0 PERFORM NATIVE-STORAGE-ERROR END-IF
            EXIT PARAGRAPH
        END-IF
        IF FS-OCC NOT = "00" PERFORM NATIVE-STORAGE-ERROR EXIT PARAGRAPH END-IF
        MOVE "P" TO OCC-STATE
        MOVE "N" TO R-READY
        START OCCURRENCES-FILE KEY IS GREATER THAN OR EQUAL TO OCC-STATE
            INVALID KEY CONTINUE
            NOT INVALID KEY
                READ OCCURRENCES-FILE NEXT
                    AT END CONTINUE
                    NOT AT END
                        IF OCC-STATE = "P"
                            MOVE OCC-RECORD TO R-SAVED-INTENT
                            MOVE "Y" TO R-READY
                        END-IF
                END-READ
        END-START
        CLOSE OCCURRENCES-FILE
        IF R-READY NOT = "Y" EXIT PARAGRAPH END-IF
        PERFORM APPLY-INTENT
        IF W-STORAGE-ERROR = "Y" EXIT PARAGRAPH END-IF
        PERFORM ADVANCE-INTENT-RULE
        IF W-STORAGE-ERROR = "Y" EXIT PARAGRAPH END-IF
    END-PERFORM.
    PERFORM NATIVE-STORAGE-ERROR.

VALIDATE-STORED-RULE.
    IF RULE-ID IS NOT NUMERIC OR RULE-AMOUNT IS NOT NUMERIC
       OR RULE-ANCHOR IS NOT NUMERIC
        PERFORM NATIVE-STORAGE-ERROR EXIT PARAGRAPH
    END-IF.
    IF RULE-ID = 0 OR RULE-AMOUNT = 0 OR RULE-ANCHOR < 1 OR RULE-ANCHOR > 31
       OR RULE-CYCLE NOT = "MONTHLY" AND "WEEKLY" AND "YEARLY"
       OR RULE-ACTIVE NOT = "Y" AND "N" OR RULE-ARCHIVED NOT = "Y" AND "N"
       OR RULE-CAT NOT = "Venituri" AND "Locuinta" AND "Mancare" AND "Hobby" AND "Utilitati"
       OR RULE-DESC = SPACES
        PERFORM NATIVE-STORAGE-ERROR EXIT PARAGRAPH
    END-IF.
    IF RULE-DATE(1:4) IS NOT NUMERIC OR RULE-DATE(6:2) IS NOT NUMERIC
       OR RULE-DATE(9:2) IS NOT NUMERIC OR RULE-DATE(5:1) NOT = "-"
       OR RULE-DATE(8:1) NOT = "-" OR RULE-DATE < "1601-01-01"
        PERFORM NATIVE-STORAGE-ERROR EXIT PARAGRAPH
    END-IF.
    STRING RULE-DATE(1:4) RULE-DATE(6:2) RULE-DATE(9:2) INTO R-DATE-NUM END-STRING.
    IF FUNCTION TEST-DATE-YYYYMMDD(R-DATE-NUM) NOT = 0
        PERFORM NATIVE-STORAGE-ERROR
    END-IF.
