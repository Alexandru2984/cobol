SQL-OPEN.
    MOVE 0 TO SQL-OP PERFORM SQL-CALL.
SQL-CLOSE.
    MOVE 1 TO SQL-OP PERFORM SQL-CALL.
SQL-READ.
    MOVE 2 TO SQL-OP PERFORM SQL-CALL.
SQL-INSERT.
    MOVE 3 TO SQL-OP PERFORM SQL-CALL.
SQL-UPDATE.
    MOVE 4 TO SQL-OP PERFORM SQL-CALL.
SQL-DELETE.
    MOVE 5 TO SQL-OP PERFORM SQL-CALL.
SQL-NEXT.
    MOVE 11 TO SQL-OP PERFORM SQL-CALL.
SQL-HIGHWATER.
    MOVE 12 TO SQL-OP PERFORM SQL-CALL.
    MOVE SQL-ID TO W-LAST-ID.
SQL-CALL.
    IF SQL-OP = 2 OR 3 OR 4 OR 5
        MOVE TRANS-ID TO SQL-ID
    END-IF.
    IF SQL-OP = 3 OR 4 COMPUTE SQL-CENTS = TRANS-AMOUNT * 100 END-IF.
    CALL STATIC "ledger_store" USING SQL-OP SQL-ID TRANS-DATE TRANS-CAT
        TRANS-DESC SQL-CENTS FS-LEDGER SQL-FORCE-DEFAULT END-CALL.
    IF FS-LEDGER = "00" AND (SQL-OP = 2 OR 11)
        MOVE SQL-ID TO TRANS-ID
        COMPUTE TRANS-AMOUNT = SQL-CENTS / 100
    END-IF.
    IF FS-LEDGER NOT = "00" AND "10" AND "23"
        PERFORM NATIVE-STORAGE-ERROR
    END-IF.

SQL-AUTH-CHECK.
    IF W-STORAGE-ERROR = "Y"
        DISPLAY "Status: 503 Service Unavailable" DISPLAY " " EXIT PARAGRAPH
    END-IF.
    IF W-LOGGED-IN NOT = "Y"
        DISPLAY "Status: 401 Unauthorized" DISPLAY " " EXIT PARAGRAPH
    END-IF.
    PERFORM CHECK-LEDGER-STORAGE.
    IF SQL-AUTH = "2" AND W-STORAGE-ERROR NOT = "Y"
        PERFORM RECOVER-OCCURRENCES
        PERFORM SQL-OPEN
        PERFORM SQL-HIGHWATER
        PERFORM SQL-CLOSE
        PERFORM RAISE-RESERVED-ID
    END-IF.
    IF W-STORAGE-ERROR = "Y"
        DISPLAY "Status: 503 Service Unavailable"
    ELSE
        DISPLAY "Status: 204 No Content"
        DISPLAY "X-Ledger-Reserved: " W-LAST-ID
    END-IF.
    DISPLAY " ".

SQL-ADMIN-RUN.
    EVALUATE SQL-ADMIN
      WHEN "legacy"
        OPEN INPUT TRANSACTIONS-FILE
        IF FS-LEDGER NOT = "00" MOVE 1 TO RETURN-CODE EXIT PARAGRAPH END-IF
        MOVE 0 TO TRANS-ID
        START TRANSACTIONS-FILE KEY IS GREATER THAN TRANS-ID
            INVALID KEY MOVE "Y" TO W-EOF END-START
        PERFORM UNTIL W-EOF = "Y"
            READ TRANSACTIONS-FILE NEXT
                AT END MOVE "Y" TO W-EOF
                NOT AT END PERFORM RENDER-CSV-ROW
            END-READ
            IF FS-LEDGER NOT = "00" AND "10" MOVE 1 TO RETURN-CODE EXIT PERFORM END-IF
        END-PERFORM
        CLOSE TRANSACTIONS-FILE
      WHEN "init"
        PERFORM SQL-OPEN PERFORM SQL-CLOSE
        IF W-STORAGE-ERROR = "Y" MOVE 1 TO RETURN-CODE END-IF
      WHEN "export"
        PERFORM SQL-OPEN
        MOVE 6 TO SQL-OP PERFORM SQL-CALL
        PERFORM UNTIL W-STORAGE-ERROR = "Y"
            PERFORM SQL-NEXT
            IF FS-LEDGER = "10" EXIT PERFORM END-IF
            IF FS-LEDGER = "00" PERFORM RENDER-CSV-ROW END-IF
        END-PERFORM
        PERFORM SQL-CLOSE
        IF W-STORAGE-ERROR = "Y" MOVE 1 TO RETURN-CODE END-IF
      WHEN OTHER MOVE 1 TO RETURN-CODE
    END-EVALUATE.
