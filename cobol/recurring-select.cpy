    SELECT RULES-FILE ASSIGN TO "data/recurring.dat"
        ORGANIZATION IS INDEXED ACCESS MODE IS DYNAMIC
        RECORD KEY IS RULE-ID
        ALTERNATE RECORD KEY IS RULE-CREATE-KEY
        FILE STATUS IS FS-RULES.
    SELECT OCCURRENCES-FILE ASSIGN TO "data/occurrences.dat"
        ORGANIZATION IS INDEXED ACCESS MODE IS DYNAMIC
        RECORD KEY IS OCC-KEY
        ALTERNATE RECORD KEY IS OCC-TX-ID
        ALTERNATE RECORD KEY IS OCC-STATE WITH DUPLICATES
        FILE STATUS IS FS-OCC.
